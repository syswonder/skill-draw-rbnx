# Render a PNG preview from a declarative JSON scene.
#
# This is the debug/preview path, not the drawing path. It is enabled only
# when the skill config has debug=true. With debug=false the call returns
# success=false and writes nothing; plot with scene (declarative
# scenes) or image (existing image files) instead.
#
# The skill does NOT execute Python or arbitrary drawing code. spec is a
# JSON object with millimetre coordinates on a canvas whose origin is the
# lower-left corner (+X right, +Y up):
#
#   {
#     "width_mm": 180, "height_mm": 150,
#     "strokes": [
#       [[10,10], [20,20], [30,10]],
#       {"points": [[40,40], [50,50]], "width_mm": 0.5, "closed": false}
#     ],
#     "shapes": [
#       {"type": "line", "x1": 10, "y1": 10, "x2": 90, "y2": 10},
#       {"type": "polyline", "points": [[10,20], [20,30]], "closed": false},
#       {"type": "polygon", "points": [[10,20], [20,30], [30,20]]},
#       {"type": "rect", "x": 10, "y": 10, "w": 40, "h": 20},
#       {"type": "circle", "cx": 90, "cy": 75, "r": 30},
#       {"type": "ellipse", "cx": 90, "cy": 75, "rx": 40, "ry": 20},
#       {"type": "arc", "cx": 90, "cy": 75, "r": 30,
#        "start_deg": 0, "end_deg": 180}
#     ]
#   }
#
# width_mm/height_mm default to the skill config and must fit the
# workspace. Strokes are emitted first, then shapes, in list order. Each
# stroke/shape may set width_mm (default from config) and closed. The
# scene must contain at least one drawable stroke. Fills, colours, and
# text are not supported.
#
# output_name is reduced to one sanitised filename inside output_dir and
# forced to .png. An empty name generates a timestamped name. Existing
# files are preserved unless overwrite=true.
#
# The skill config's debug flag gates this tool. With debug=true the PNG
# is rendered and written to output_dir, and image_path is set. With
# debug=false the request is rejected and no file is written; use
# scene or image to plot instead.
#
# pixel_to_mm <= 0, line_width_mm <= 0, and supersample <= 0 use the
# skill config. pixel_to_mm is millimetres per pixel, matching the SDK
# and the PNG metadata (0.25 = 4 px/mm). The PNG embeds Robonix
# orientation/scale metadata so image can reproduce it upright and
# at 1:1 scale, but scene is the preferred way to plot the same
# scene.
string  spec
string  output_name
bool    overwrite
float64 pixel_to_mm
float64 line_width_mm
int32   supersample
---
bool    success
string  message
# Absolute path inside output_dir; empty when debug=false (nothing written).
string  image_path
uint32  width_px
uint32  height_px
float64 width_mm
float64 height_mm
float64 pixel_to_mm
uint32  strokes
uint32  points
float64 elapsed_s