# List image files that the image tool is allowed to read.
#
# Searches image_dir and output_dir non-recursively. filter is an optional
# case-insensitive filename substring. Results are absolute paths, sorted
# by filename, capped by the skill's max_list_images config.
string  filter
---
bool    success
string  message
string[] images
uint32  count
string  image_dir
string  output_dir
float64 elapsed_s